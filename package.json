{
  "name": "dsh-emotion",
  "version": "0.1.1",
  "description": "让 DSH agent 的输出自带情绪：会话投影状态机 + 提示词情绪段 + 会话头部情绪条（非官方插件）",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib",
    "client",
    "style",
    "tools",
    "cordis.patch.yml",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "emotion",
    "mood",
    "情绪"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-system-prompt": ">=0.1.7-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-session-projection": ">=0.1.7-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-commands": ">=0.1.7-rc.2 <0.3.0-0",
    "@deepseek-ai/dsh-home-paths": ">=0.1.7-rc.2 <0.3.0-0",
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "dependencies": {
    "zod": "^4.6.5"
  }
}
